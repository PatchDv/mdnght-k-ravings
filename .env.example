# Copy to .env and fill in. Never commit .env — it holds real secrets.
# The server fails fast in production (NODE_ENV=production) when a secret is
# missing or shorter than 32 characters.

NODE_ENV=development
PORT=3000

# 32+ char random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET signs customer sessions; ADMIN_JWT_SECRET signs admin step
# tokens; OTP_PEPPER keys the one-time-code hashes (a leaked database alone
# must not reveal codes).
JWT_SECRET=
ADMIN_JWT_SECRET=
OTP_PEPPER=

# SMS gateway: "textbee" (real gateway — sends from your registered Android
# SIM; register the device at textbee.dev/dashboard) or "console"
# (development only — nothing is sent, and it is refused in production).
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
# Optional: pin a specific textbee device; omit to use the default device.
# TEXTBEE_DEVICE_ID=

# Production hardening:
#   NODE_ENV=production
#   ALLOWED_ORIGIN=https://yourdomain.com   (CORS allowlist for the API)
#   FORCE_HTTPS=true                        (301 to https + HSTS header)

# First-run seed admin only; both required together when the database has no
# admin yet. There is no default password anywhere in the code.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Secret staff-door path (login page at this path, dashboard at <path>/board).
# One random-looking segment, no trailing slash. The old /admin path is dead
# and answers 404.
ADMIN_PATH=/staff-portal-x7k2

# Development only: returns the one-time code in the API response on a dev
# machine with a real provider, so automated tests can complete flows.
# NEVER set this in production — the flag is force-disabled there.
# OTP_TEST_DEBUG=true
